<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>debbd868-93d0-4ef4-a8dc-2c0c8255dfe6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.34">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Fija Relational en la misma versión que EF Core (8.0.22). Npgsql 8.0.11 solo pide >= 8.0.11;
         sin esta línea, el proyecto de pruebas resolvía 8.0.11 y producía MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.34" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <!-- Autenticación segura: envío de códigos por SMTP. 4.16+ corrige GHSA-9j88-vvj5-vhgr (MailKit) y trae
         MimeKit sin GHSA-g7hc-96xr-gvvx. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- Fija la versión corregida de la dependencia transitiva de MimeKit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Despliegue: la configuración local (con secretos de desarrollo) nunca se copia a la carpeta de dotnet publish.
       En producción todo llega por variables de entorno (deploy/azure/climaplus-api.env.example). -->
  <ItemGroup>
    <Content Update="appsettings.Development.json;appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>

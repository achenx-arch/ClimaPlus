{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ClimaPlus.Seguridad": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emisor": "ClimaPlus.Api",
    "Audiencia": "ClimaPlus.Frontend",
    "MinutosExpiracion": 60
  },
  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:5173" ]
  },
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org",
    "TimeoutSegundos": 8,
    "Unidades": "metric",
    "Idioma": "es"
  },
  "RateLimiting": {
    "Autenticacion": {
      "PermitLimit": 5,
      "VentanaSegundos": 60
    },
    "Clima": {
      "PermitLimit": 30,
      "VentanaSegundos": 60
    },
    "Dispositivos": {
      "PermitLimit": 30,
      "VentanaSegundos": 60
    },
    "General": {
      "PermitLimit": 300,
      "VentanaSegundos": 60
    },
    "Registro": {
      "PermitLimit": 5,
      "VentanaSegundos": 600
    },
    "Codigos": {
      "PermitLimit": 20,
      "VentanaSegundos": 60
    },
    "Reenvio": {
      "PermitLimit": 10,
      "VentanaSegundos": 3600
    },
    "Recuperacion": {
      "PermitLimit": 5,
      "VentanaSegundos": 900
    }
  },
  "Google": {
    "ClientId": "",
    "MinutosNonce": 10
  },
  "Codigos": {
    "ClaveHmac": "",
    "MinutosVerificacion": 10,
    "MinutosInicioSesion": 5,
    "MinutosCambioPassword": 5,
    "MaxIntentos": 5,
    "SegundosEntreReenvios": 60,
    "MaxReenvios": 5,
    "MaxCorreosPorHora": 5,
    "MaxFallosPorHora": 10,
    "MaxRecuperacionesPorHora": 3,
    "MinutosPermisoRestablecer": 10
  },
  "Correo": {
    "Puerto": 587,
    "Seguridad": "StartTls",
    "NombreRemitente": "ClimaPlus",
    "TimeoutSegundos": 15
  },
  "ProxyInverso": {
    "RedesConocidas": [],
    "ProxiesConocidos": []
  },
  "Seguridad": {
    "IntentosLogin": {
      "MaxFallidos": 5,
      "MaxFallidosCuenta": 20,
      "MinutosBloqueo": 15
    },
    "Cabeceras": {
      "MaxBytesCuerpo": 1048576
    }
  }
}

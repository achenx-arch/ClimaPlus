{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ClimaPlus.Seguridad": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emisor": "ClimaPlus.Api",
    "Audiencia": "ClimaPlus.Frontend",
    "MinutosExpiracion": 60
  },
  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:5173" ]
  },
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org",
    "TimeoutSegundos": 8,
    "Unidades": "metric",
    "Idioma": "es"
  },
  "RateLimiting": {
    "Autenticacion": {
      "PermitLimit": 5,
      "VentanaSegundos": 60
    },
    "Clima": {
      "PermitLimit": 30,
      "VentanaSegundos": 60
    }
  }
}

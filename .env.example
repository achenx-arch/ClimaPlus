# =====================================================================
#  ClimaPlus – Variables de Docker Compose (Fase 9)
#  Copia este archivo como .env y cambia los valores. .env NO se sube a GitHub (.gitignore).
# =====================================================================

# Base de datos (solo dentro de Docker)
POSTGRES_USER=climaplus
POSTGRES_PASSWORD=cambia-esta-clave-de-base-de-datos

# Clave para firmar los JWT: 32 caracteres o más, aleatoria. Ejemplo para generarla en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_CLAVE=cambia-esta-clave-por-una-aleatoria-de-32-caracteres-o-mas

# Clave HMAC de los códigos de verificación enviados por correo: 32 caracteres o más, aleatoria y DISTINTA de
# JWT_CLAVE (la API no arranca si son iguales). Se genera igual que JWT_CLAVE.
CODIGOS_CLAVE_HMAC=cambia-esta-otra-clave-hmac-de-32-caracteres-o-mas

# API Key de OpenWeather (sin ella, las rutas de clima responden 503)
OPENWEATHER_API_KEY=

# URLs públicas: dónde abre el navegador el frontend y dónde llama a la API
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Correo (códigos de verificación). Guía completa: docs/despliegue/correo-smtp.md
#   - Desarrollo local: deja SMTP_* vacíos = Mailpit (no envía nada a Internet; bandeja en http://localhost:8025).
#   - Demostración con Gmail: cuenta dedicada con verificación en 2 pasos y una "contraseña de aplicación".
#       SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SEGURIDAD=StartTls
#       SMTP_USER=climaplus.ejemplo@gmail.com  SMTP_PASSWORD=<contraseña de aplicación>  SMTP_FROM=climaplus.ejemplo@gmail.com
#   - Producción con Brevo (dominio propio verificado con SPF y DKIM):
#       SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SEGURIDAD=StartTls
#       SMTP_USER=<login SMTP de Brevo>  SMTP_PASSWORD=<clave SMTP de Brevo>  SMTP_FROM=no-reply@tu-dominio
#   Con docker-compose.prod.yml, SMTP_HOST, SMTP_PORT, SMTP_FROM y SMTP_SEGURIDAD son obligatorios.
#   Nunca subas estos valores a GitHub.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ClimaPlus
SMTP_SEGURIDAD=

# Proxy HTTPS delante de la API (Caddy en el mismo servidor): red de Docker, por ejemplo 172.16.0.0/12.
# Vacío en local (sin proxy).
PROXY_RED_CONOCIDA=

# Administrador inicial (opcional; solo se crea si no existe otro administrador). Usa un correo REAL al que tengas
# acceso: el primer inicio de sesión pide un código enviado a ese correo (con SMTP real ya no llega a Mailpit).
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=

# "Continuar con Google" (opcional). Client ID de un cliente OAuth "Aplicación web" de Google Cloud, por ejemplo
# 1234567890-abc123.apps.googleusercontent.com. Vacío = botón de Google desactivado. NO hace falta Client Secret.
# Guía: docs/despliegue/google-oauth.md
GOOGLE_CLIENT_ID=

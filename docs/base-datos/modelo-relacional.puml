@startuml modelo-relacional
' =====================================================================
'  ClimaPlus – Modelo relacional definitivo (FASE 1)
'  Estado: aprobado (decisiones D-01 a D-13)
'  Motor de referencia: PostgreSQL 16
'  Identificadores: BIGINT GENERATED BY DEFAULT AS IDENTITY
'  PK = llave primaria · FK = llave foránea · UQ = único
' =====================================================================

hide circle
hide empty methods
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype polyline
skinparam roundCorner 6
skinparam nodesep 60
skinparam ranksep 70
skinparam ArrowColor #37474F

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #455A64
  HeaderBackgroundColor #CFD8DC
}

title ClimaPlus – Modelo relacional (PostgreSQL)

' ---------------------------------------------------------------------
'  ENTIDADES PRINCIPALES
' ---------------------------------------------------------------------
entity "USUARIO" as usuario {
  <b>PK</b> id_usuario : BIGINT IDENTITY
  --
  nombre : VARCHAR(100) NOT NULL
  <b>UQ</b> correo : VARCHAR(150) NOT NULL
  password_hash : VARCHAR(255) NOT NULL
  rol : VARCHAR(20) NOT NULL DEFAULT 'USUARIO'
  activo : BOOLEAN NOT NULL DEFAULT TRUE
  fecha_creacion : TIMESTAMPTZ NOT NULL DEFAULT now()
}

entity "UBICACION" as ubicacion {
  <b>PK</b> id_ubicacion : BIGINT IDENTITY
  --
  nombre : VARCHAR(100) NOT NULL
  region : VARCHAR(100) NULL
  pais : CHAR(2) NOT NULL
  <b>UQ(1)</b> latitud : NUMERIC(7,4) NOT NULL
  <b>UQ(1)</b> longitud : NUMERIC(8,4) NOT NULL
  fecha_creacion : TIMESTAMPTZ NOT NULL DEFAULT now()
}

' ---------------------------------------------------------------------
'  ENTIDADES DEPENDIENTES
' ---------------------------------------------------------------------
entity "FAVORITO" as favorito {
  <b>PK</b> id_favorito : BIGINT IDENTITY
  --
  <b>FK UQ(1)</b> id_usuario : BIGINT NOT NULL
  <b>FK UQ(1)</b> id_ubicacion : BIGINT NOT NULL
  fecha_creacion : TIMESTAMPTZ NOT NULL DEFAULT now()
}

entity "CONFIGURACION_ALERTA" as configuracion_alerta {
  <b>PK</b> id_configuracion : BIGINT IDENTITY
  --
  <b>FK UQ(1)</b> id_usuario : BIGINT NOT NULL
  <b>FK UQ(1)</b> id_ubicacion : BIGINT NULL
  <b>UQ(1)</b> tipo : VARCHAR(20) NOT NULL
  valor_umbral : NUMERIC(5,2) NULL
  activa : BOOLEAN NOT NULL DEFAULT TRUE
  fecha_creacion : TIMESTAMPTZ NOT NULL DEFAULT now()
  ..
  UQ(1) con NULLS NOT DISTINCT
}

entity "CONSULTA_CLIMA" as consulta_clima {
  <b>PK</b> id_consulta : BIGINT IDENTITY
  --
  <b>FK</b> id_usuario : BIGINT NOT NULL
  <b>FK</b> id_ubicacion : BIGINT NOT NULL
  tipo_consulta : VARCHAR(20) NOT NULL
  temperatura : NUMERIC(5,2) NULL
  sensacion_termica : NUMERIC(5,2) NULL
  humedad : SMALLINT NULL
  velocidad_viento : NUMERIC(5,2) NULL
  codigo_condicion : SMALLINT NULL
  descripcion_condicion : VARCHAR(100) NULL
  fecha_consulta : TIMESTAMPTZ NOT NULL DEFAULT now()
  ..
  CHECK: mediciones obligatorias si ACTUAL,
  todas NULL si PRONOSTICO
}

entity "DISPOSITIVO" as dispositivo {
  <b>PK</b> id_dispositivo : BIGINT IDENTITY
  --
  <b>FK UQ(1)</b> id_usuario : BIGINT NOT NULL
  <b>FK</b> id_ubicacion : BIGINT NOT NULL
  <b>UQ(1)</b> nombre : VARCHAR(100) NOT NULL
  <b>UQ</b> api_key_hash : CHAR(64) NOT NULL
  activo : BOOLEAN NOT NULL DEFAULT TRUE
  ultima_conexion : TIMESTAMPTZ NULL
  fecha_creacion : TIMESTAMPTZ NOT NULL DEFAULT now()
}

entity "LECTURA_SENSOR" as lectura_sensor {
  <b>PK</b> id_lectura : BIGINT IDENTITY
  --
  <b>FK</b> id_dispositivo : BIGINT NOT NULL
  temperatura : NUMERIC(5,2) NULL
  humedad : NUMERIC(5,2) NULL
  lluvia : BOOLEAN NULL
  luz : SMALLINT NULL
  fecha_lectura : TIMESTAMPTZ NOT NULL DEFAULT now()
}

entity "ALERTA" as alerta {
  <b>PK</b> id_alerta : BIGINT IDENTITY
  --
  <b>FK</b> id_usuario : BIGINT NOT NULL
  <b>FK</b> id_ubicacion : BIGINT NOT NULL
  <b>FK</b> id_consulta : BIGINT NULL
  <b>FK</b> id_lectura : BIGINT NULL
  tipo : VARCHAR(20) NOT NULL
  valor_detectado : NUMERIC(5,2) NULL
  valor_umbral : NUMERIC(5,2) NULL
  mensaje : VARCHAR(255) NOT NULL
  estado : VARCHAR(20) NOT NULL DEFAULT 'NUEVA'
  fecha_generacion : TIMESTAMPTZ NOT NULL DEFAULT now()
  ..
  CHECK: exactamente uno de
  id_consulta / id_lectura
}

' ---------------------------------------------------------------------
'  RELACIONES
'  ||  exactamente uno    |o  cero o uno    o{  cero o muchos
' ---------------------------------------------------------------------
' Fila 2: entidades que dependen solo de USUARIO y/o UBICACION
usuario   ||--o{ favorito
ubicacion ||--o{ favorito

usuario   ||--o{ configuracion_alerta
ubicacion |o--o{ configuracion_alerta

usuario   ||--o{ dispositivo
ubicacion ||--o{ dispositivo

usuario   ||--o{ consulta_clima
ubicacion ||--o{ consulta_clima

' Fila 3: lecturas físicas
dispositivo ||--o{ lectura_sensor

' Fila 4: alertas (origen: consulta de OpenWeather o lectura del ESP32)
consulta_clima |o--o{ alerta
lectura_sensor |o--o{ alerta
usuario   ||--o{ alerta
ubicacion ||--o{ alerta

legend bottom right
  <b>Notas</b>
  • UQ(1): las columnas marcadas forman juntas una restricción UNIQUE compuesta.
  • Dominios (CHECK): rol ∈ {USUARIO, ADMINISTRADOR};
    tipo ∈ {LLUVIA, TEMPERATURA_ALTA, TEMPERATURA_BAJA}; estado ∈ {NUEVA, LEIDA};
    tipo_consulta ∈ {ACTUAL, PRONOSTICO}.
  • configuracion_alerta.id_ubicacion NULL = la regla aplica a todas las ubicaciones.
  • Unidades: temperatura °C, viento m/s, humedad y luz en %.
  • Solo se registran consultas de usuarios autenticados; las alertas solo nacen de consultas ACTUAL.
endlegend

@enduml

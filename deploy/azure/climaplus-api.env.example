# =====================================================================
#  ClimaPlus – Variables de la API en la VM de Azure (plantilla SIN secretos)
#  Copiar en la VM como /etc/climaplus/api.env (propietario root, grupo climaplus, permisos 640):
#    sudo install -o root -g climaplus -m 640 climaplus-api.env.example /etc/climaplus/api.env
#    sudo nano /etc/climaplus/api.env
#  Nunca subir el archivo real a Git. systemd no interpreta $ ni comillas como un shell: evita " y \ en los valores.
#  Reemplaza <DOMINIO> por el nombre DNS público (por ejemplo climaplus-umg.westus2.cloudapp.azure.com).
# =====================================================================

# PostgreSQL local (solo escucha en 127.0.0.1). Usuario propio de la aplicación, no "postgres".
ConnectionStrings__ClimaPlusDb=Host=127.0.0.1;Port=5432;Database=climaplus_db;Username=climaplus_app;Password=REEMPLAZAR

# Claves NUEVAS para producción (32+ caracteres cada una, distintas entre sí). Generar en la VM con:
#   openssl rand -base64 48
Jwt__Clave=REEMPLAZAR
Codigos__ClaveHmac=REEMPLAZAR

# Gmail SMTP (puerto 465 con TLS desde el primer byte; Azure solo bloquea el 25). Contraseña de aplicación de Google.
Correo__Host=smtp.gmail.com
Correo__Puerto=465
Correo__Seguridad=SslAlConectar
Correo__Usuario=REEMPLAZAR
Correo__Password=REEMPLAZAR
Correo__Remitente=REEMPLAZAR
Correo__NombreRemitente=ClimaPlus

# Opcionales
OpenWeather__ApiKey=
Google__ClientId=

# Origen público del frontend (exacto, con https y sin barra final).
Cors__OrigenesPermitidos__0=https://<DOMINIO>

# Nginx está en la misma VM: la API solo confía en X-Forwarded-For / X-Forwarded-Proto si vienen de 127.0.0.1 o ::1.
# Sin esto, el rate limiting y el bloqueo por IP tratarían a todos los usuarios como uno solo (la IP de Nginx).
ProxyInverso__ProxiesConocidos__0=127.0.0.1
ProxyInverso__ProxiesConocidos__1=::1

# Nombres de host aceptados (separados por ;). localhost y 127.0.0.1 permiten las comprobaciones locales con curl.
AllowedHosts=<DOMINIO>;localhost;127.0.0.1

# Administrador inicial: vacío (el administrador real ya existe en la copia de climaplus_db).
AdminInicial__Correo=
AdminInicial__Password=

# =====================================================================
#  ClimaPlus – Variables para docker-compose.azure.yml (plantilla SIN secretos)
#  En la VM:  cp deploy/azure/docker/azure.env.example .env.azure && chmod 600 .env.azure && nano .env.azure
#  .env.azure está ignorado por Git (.gitignore: .env.*). Nunca lo subas ni lo copies dentro de una imagen.
#  Genera cada clave con:  openssl rand -base64 48 | tr -d '\n=/+' | cut -c1-48
#  Evita comillas, espacios y el carácter $ en los valores.
# =====================================================================

# Nombre DNS público de la IP de la VM (etiqueta DNS de Azure), sin https:// ni barra final.
DOMINIO=climaplus-umg.westus2.cloudapp.azure.com
# Correo para avisos de Let's Encrypt (vencimiento del certificado).
CORREO_LETSENCRYPT=REEMPLAZAR

# PostgreSQL: superusuario del contenedor (solo administración) y usuario propio de la aplicación.
POSTGRES_SUPERUSER_PASSWORD=REEMPLAZAR
CLIMAPLUS_DB_PASSWORD=REEMPLAZAR

# Claves NUEVAS de producción (32+ caracteres, distintas entre sí).
JWT_CLAVE=REEMPLAZAR
CODIGOS_CLAVE_HMAC=REEMPLAZAR

# Gmail SMTP (465, TLS): cuenta de envío y su contraseña de aplicación (sin espacios).
SMTP_USER=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
SMTP_FROM=REEMPLAZAR

# Opcionales
OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=
